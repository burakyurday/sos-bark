<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B111B">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="630dp"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="26dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SOS  /  GÜVENLİK"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.20"
                android:textColor="#C5D0E0" />
            <Button
                android:id="@+id/settingsButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="78dp"
                android:background="@drawable/bg_button"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Ayarlar"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="Yardıma\nihtiyacın olduğunda."
            android:textSize="33sp"
            android:lineSpacingExtra="0dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#F5F8FF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tek hareketle acil kişine haber ver."
            android:textSize="15sp"
            android:textColor="#A4B4C9" />

        <TextView
            android:id="@+id/connectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:text="●  ALICI BAĞLANTISI KAYITLI"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:textColor="#77D3A9" />

        <FrameLayout
            android:id="@+id/sosButton"
            android:layout_width="244dp"
            android:layout_height="244dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="17dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="SOS. Yardım göndermek için iki saniye basılı tut"
            android:background="@drawable/bg_sos"
            android:elevation="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOS"
                    android:textColor="#FFFFFF"
                    android:textSize="55sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BASILI TUT"
                    android:textColor="#FFE5E8"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.22" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/holdHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Göndermek için 2 saniye basılı tut"
            android:textSize="14sp"
            android:textColor="#C8D4E6" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="66dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:text="Hazır. Bir acil durumda SOS'a basılı tut."
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:textColor="#CED9E9" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="5 kritik alarm  ·  45 saniye arayla"
            android:textSize="12sp"
            android:textColor="#98A8BC" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Gerçek acil durumda 112'yi de ara."
            android:textSize="11sp"
            android:textColor="#7889A1" />
    </LinearLayout>
</ScrollView>
